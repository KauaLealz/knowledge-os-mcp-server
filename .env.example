# MCP Knowledge OS — Configuração de Ambiente
#
# Os dados ficam na pasta (repositório git) de cada conexão, criada pelo MCP com
# connection_create(name, path[, remote_url]). Nada aqui aponta para os dados.

# Home local (connections.json, repos.json, usage/, locks/, pending.jsonl)
# KNOWLEDGE_OS_HOME=~/.knowledge-os

# A UI local sobe junto com o servidor MCP; 0 desliga
# KNOWLEDGE_OS_UI=1

# Nível de logging
# Opções: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
