# MCP Knowledge OS — Configuração de Ambiente

# Caminho do banco de dados SQLite (opcional)
# Padrão: <KNOWLEDGE_OS_HOME>/knowledge.db (home padrão: ~/.knowledge-os)
# MCP_DB_PATH=/caminho/para/knowledge.db

# Pasta de dados (connections.json, knowledge.db, artifacts/, exports/, backups/)
# KNOWLEDGE_OS_HOME=~/.knowledge-os

# Chave de criptografia SQLCipher (opcional)
# Se não definido, SQLite funciona sem criptografia
# Se definido, SQLCipher criptografa o banco com AES-256
# Mínimo: 16 caracteres
# Recomendado: use um gerador de senhas forte, ex: $(openssl rand -base64 32)
# MCP_DB_KEY=your_strong_encryption_key_here_at_least_16_chars

# Nível de logging
# Opções: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
